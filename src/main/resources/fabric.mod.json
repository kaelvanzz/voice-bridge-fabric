{
  "schemaVersion": 1,
  "id": "voice-bridge",
  "version": "${version}",
  "name": "Voice Bridge",
  "description": "A Fabric port of PfauMC's Voice Bridge - bridges voice communication between Simple Voice Chat and Plasmo Voice",
  "authors": ["kaelvanzz", "andreypfau"],
  "contact": {
    "homepage": "https://modrinth.com/mod/voice-bridge-fabric"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "io.pfaumc.voicebridge.VoiceBridgeMod"
    ],
    "voicechat": [
      "io.pfaumc.voicebridge.adapter.SvcAdapter"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21.5 <1.21.12",
    "java": ">=21",
    "voicechat": "*",
    "plasmovoice": ">=2.1.8"
  }
}
